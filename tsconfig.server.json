{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/server",
    "rootDir": "src",
    "allowJs": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["src/server.ts", "src/config/**/*", "src/db/**/*", "src/models/**/*", "src/services/limitAlerts.ts", "src/types/**/*"],
  "exclude": ["node_modules", "dist", "src/components/**/*", "src/context/**/*", "src/contexts/**/*", "src/services/api.ts", "src/App.tsx", "src/main.tsx"],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
} 